# Refyn — credentials and model choice.
#
# Copy this file to `.env` and fill in your API key. `.env` is gitignored and
# never leaves your machine.
#
#     copy .env.example .env
#
# You can also set the key from the Settings window instead; it writes this
# same file, preserving your comments.

# ---------------------------------------------------------------- STEP 1: KEY
# Paste your API key here — no quotes, no spaces.
# Get a free one at https://build.nvidia.com (starts with "nvapi-").
NIM_API_KEY=

# ----------------------------------------------------------- STEP 2: ENDPOINT
# Any OpenAI-compatible /chat/completions endpoint works.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Other providers — uncomment one and set NIM_API_KEY to its key:
#   Groq        NIM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter  NIM_BASE_URL=https://openrouter.ai/api/v1
#   Together    NIM_BASE_URL=https://api.together.xyz/v1
#   Cerebras    NIM_BASE_URL=https://api.cerebras.ai/v1
#   Ollama      NIM_BASE_URL=http://localhost:11434/v1   (key can be anything)

# -------------------------------------------------------------- STEP 3: MODEL
# The recommended default: best balance of speed and quality, and the only
# model tested that did not invent requirements on messy real-world prompts.
REFYN_MODEL=deepseek-ai/deepseek-v4-flash-0731

# Faster alternative (0.5-1s, great for short prompts, drifts on long ones):
#   REFYN_MODEL=meta/llama-3.1-8b-instruct
# Local via Ollama:
#   REFYN_MODEL=llama3.1:8b
#
# Model IDs differ per provider and get retired — check your provider's
# catalogue rather than trusting this list. See the README for measurements.

# --------------------------------------------------------------------- OPTIONAL
# Local port for the daemon. Change only if something else uses 8477.
REFYN_PORT=8477
